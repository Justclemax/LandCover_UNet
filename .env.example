# Copier en .env puis adapter :  cp .env.example .env

# Application Streamlit (lu nativement par Streamlit)
STREAMLIT_SERVER_PORT=8501

# API d'inférence Rust (serving/)
API_HOST=127.0.0.1
API_PORT=8030
LANDCOVER_BUNDLE_DIR=models/rust
# Clé exigée sur /v1/predict/* (vide = API ouverte, à réserver au développement)
API_KEY=
# Origines web autorisées à appeler l'API depuis un navigateur ("*" ou liste séparée par des virgules)
CORS_ORIGINS=
MAX_CONCURRENT=2

# Adresse de l'API utilisée par l'application
LANDCOVER_API_URL=http://127.0.0.1:${API_PORT}
